{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kitsu:schema:chat:v1",
  "title": "Kitsu chat JSONL event (v1)",
  "description": "One line-delimited event emitted by Kitsu --jsonl.",
  "oneOf": [
    { "$ref": "#/$defs/run_started" },
    { "$ref": "#/$defs/model_catalog" },
    { "$ref": "#/$defs/turn_started" },
    { "$ref": "#/$defs/provider_request" },
    { "$ref": "#/$defs/structured_finalization_deferred" },
    { "$ref": "#/$defs/provider_attempt" },
    { "$ref": "#/$defs/assistant_delta" },
    { "$ref": "#/$defs/usage" },
    { "$ref": "#/$defs/tool_started" },
    { "$ref": "#/$defs/tool_finished" },
    { "$ref": "#/$defs/background_result" },
    { "$ref": "#/$defs/assistant" },
    { "$ref": "#/$defs/assistant_disposition" },
    { "$ref": "#/$defs/turn_finished" },
    { "$ref": "#/$defs/output_schema" },
    { "$ref": "#/$defs/completion_postcondition" },
    { "$ref": "#/$defs/output_last_message" },
    { "$ref": "#/$defs/command_started" },
    { "$ref": "#/$defs/command_result" },
    { "$ref": "#/$defs/command_finished" },
    { "$ref": "#/$defs/context_window_mismatch" },
    { "$ref": "#/$defs/review_disclosure" },
    { "$ref": "#/$defs/workspace_evidence_disclosure" },
    { "$ref": "#/$defs/rollback_retained_changes" },
    { "$ref": "#/$defs/error" },
    { "$ref": "#/$defs/final_summary" },
    { "$ref": "#/$defs/forward_compatible_event" }
  ],
  "$defs": {
    "envelope": {
      "type": "object",
      "required": ["schema", "type", "run_id"],
      "properties": {
        "schema": { "const": "kitsu.chat.v1" },
        "type": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 }
      }
    },
    "turn_identity": {
      "type": "object",
      "required": ["turn_id"],
      "properties": {
        "turn_id": { "type": "string", "minLength": 1 }
      }
    },
    "command_identity": {
      "type": "object",
      "required": ["line", "command"],
      "properties": {
        "line": { "type": "integer", "minimum": 1 },
        "command": { "type": "string" }
      }
    },
    "provider_operation_identity": {
      "oneOf": [
        { "$ref": "#/$defs/turn_identity" },
        { "$ref": "#/$defs/command_identity" }
      ]
    },
    "command_invocation": {
      "type": "object",
      "required": ["argv", "cwd", "timeout_ms"],
      "properties": {
        "argv": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "cwd": { "type": "string" },
        "timeout_ms": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "command_executable": {
      "type": "object",
      "required": ["invocation", "resolution", "observed_path", "pinned"],
      "properties": {
        "invocation": { "type": "string" },
        "resolution": { "enum": ["ambient_path", "invocation_path"] },
        "observed_path": { "type": ["string", "null"] },
        "pinned": { "type": "boolean" }
      }
    },
    "command_ambient_authority": {
      "type": "object",
      "required": [
        "inherits_environment",
        "filesystem_confined_to_command_roots",
        "network_confined",
        "executable_identity_pinned"
      ],
      "properties": {
        "inherits_environment": { "type": "boolean" },
        "filesystem_confined_to_command_roots": { "type": "boolean" },
        "network_confined": { "type": "boolean" },
        "executable_identity_pinned": { "type": "boolean" }
      }
    },
    "artifact_policy": {
      "type": "object",
      "required": [
        "mode",
        "source",
        "new_automatic_artifact_writes",
        "command_output_persistence",
        "tool_result_offload",
        "existing_artifacts_unchanged",
        "model_artifact_read_root_granted"
      ],
      "properties": {
        "mode": { "enum": ["automatic", "disabled"] },
        "source": { "enum": ["default", "config", "cli"] },
        "new_automatic_artifact_writes": { "type": "boolean" },
        "command_output_persistence": { "type": "boolean" },
        "tool_result_offload": { "type": "boolean" },
        "existing_artifacts_unchanged": { "type": "boolean" },
        "model_artifact_read_root_granted": { "type": "boolean" }
      }
    },
    "command_execution_result": {
      "type": "object",
      "required": [
        "termination",
        "success",
        "exit_code",
        "signal",
        "elapsed_ms",
        "stdout_bytes",
        "stderr_bytes",
        "stdout_retained_bytes",
        "stderr_retained_bytes",
        "stdout_truncated",
        "stderr_truncated",
        "stdout_capture_complete",
        "stderr_capture_complete",
        "stdout_tail",
        "stderr_tail",
        "executable",
        "ambient_authority"
      ],
      "properties": {
        "termination": { "enum": ["exited", "signaled", "timed_out", "cancelled"] },
        "success": { "type": "boolean" },
        "exit_code": { "type": ["integer", "null"] },
        "signal": { "type": ["integer", "null"] },
        "elapsed_ms": { "type": "integer", "minimum": 0 },
        "stdout_bytes": { "type": "integer", "minimum": 0 },
        "stderr_bytes": { "type": "integer", "minimum": 0 },
        "stdout_retained_bytes": { "type": "integer", "minimum": 0 },
        "stderr_retained_bytes": { "type": "integer", "minimum": 0 },
        "stdout_truncated": { "type": "boolean" },
        "stderr_truncated": { "type": "boolean" },
        "stdout_capture_complete": { "type": "boolean" },
        "stderr_capture_complete": { "type": "boolean" },
        "stdout_tail": { "type": "string" },
        "stderr_tail": { "type": "string" },
        "executable": { "$ref": "#/$defs/command_executable" },
        "ambient_authority": { "$ref": "#/$defs/command_ambient_authority" },
        "artifact_status": {
          "enum": ["not_needed", "retained", "suppressed_by_policy", "unavailable", "failed"]
        },
        "artifact": {
          "type": "object",
          "required": ["reference", "captured_bytes", "truncated", "limit_bytes", "artifact_bytes"],
          "properties": {
            "reference": { "type": "string" },
            "captured_bytes": { "type": "integer", "minimum": 0 },
            "truncated": { "type": "boolean" },
            "limit_bytes": { "type": "integer", "minimum": 1 },
            "artifact_bytes": { "type": "integer", "minimum": 0 }
          }
        },
        "artifact_error": { "type": "string" },
        "containment_hint": { "type": "string" }
      }
    },
    "run_started": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": ["mode", "gateway"],
          "properties": {
            "type": { "const": "run_started" },
            "mode": { "enum": ["ask", "script", "piped", "review", "models"] },
            "gateway": { "type": "string" },
            "model": { "type": "string" },
            "session_id": { "type": ["string", "null"] },
            "resumed": { "type": "boolean" },
            "durable_session": { "type": "boolean" },
            "session_snapshot_state": { "enum": ["disabled", "pending_until_first_success", "resumable"] },
            "system_context_refreshed": { "type": "boolean" },
            "skill_context_changes": {
              "type": "array",
              "items": { "type": "string" }
            },
            "artifact_policy": { "$ref": "#/$defs/artifact_policy" }
          }
        }
      ]
    },
    "model_catalog": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": ["filter", "models", "count"],
          "properties": {
            "type": { "const": "model_catalog" },
            "filter": { "type": "string" },
            "models": {
              "type": "array",
              "items": { "type": "string" }
            },
            "count": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "turn_started": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        { "$ref": "#/$defs/turn_identity" },
        {
          "type": "object",
          "required": ["input"],
          "properties": {
            "type": { "const": "turn_started" },
            "input": { "type": "string" }
          }
        }
      ]
    },
    "provider_request": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        { "$ref": "#/$defs/provider_operation_identity" },
        {
          "type": "object",
          "required": ["round", "purpose", "message_count", "tools_offered"],
          "properties": {
            "type": { "const": "provider_request" },
            "round": { "type": "integer", "minimum": 1 },
            "purpose": { "enum": ["inference", "compaction"] },
            "message_count": { "type": "integer", "minimum": 0 },
            "tools_offered": { "type": "integer", "minimum": 0 },
            "structured_output": { "type": "boolean" }
          }
        }
      ]
    },
    "structured_finalization_deferred": {
      "description": "A descriptor-verified exact-output mismatch deferred the structured finalizer so one bounded repair round could keep the existing filesystem tools. The host instruction is request-local and grants no new authority.",
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        { "$ref": "#/$defs/turn_identity" },
        {
          "type": "object",
          "required": [
            "round",
            "repair_round",
            "finalization_round_reserved",
            "cause",
            "targets",
            "repair_instruction_disclosed",
            "write_authority_granted"
          ],
          "properties": {
            "type": { "const": "structured_finalization_deferred" },
            "round": { "type": "integer", "minimum": 1 },
            "repair_round": { "type": "integer", "minimum": 2 },
            "finalization_round_reserved": { "const": true },
            "cause": { "const": "required_write_sha256_mismatch" },
            "targets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["path", "expected_sha256", "actual_sha256"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "expected_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  "actual_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
                }
              }
            },
            "repair_instruction_disclosed": { "const": true },
            "write_authority_granted": { "const": false }
          }
        }
      ]
    },
    "provider_attempt": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        { "$ref": "#/$defs/provider_operation_identity" },
        {
          "type": "object",
          "required": [
            "round",
            "purpose",
            "attempt",
            "max_attempts",
            "category",
            "status",
            "outcome",
            "terminal",
            "retry_delay_ms",
            "retry_after_used",
            "remaining_deadline_ms"
          ],
          "properties": {
            "type": { "const": "provider_attempt" },
            "round": { "type": "integer", "minimum": 1 },
            "purpose": { "enum": ["inference", "compaction"] },
            "attempt": { "type": "integer", "minimum": 1 },
            "max_attempts": { "type": "integer", "minimum": 1 },
            "category": {
              "enum": [
                "success",
                "rate_limited",
                "unavailable",
                "authentication",
                "client_error",
                "server_error",
                "unexpected_status",
                "timeout",
                "connection",
                "response_too_large",
                "invalid_response",
                "cancelled"
              ]
            },
            "status": {
              "type": ["integer", "null"],
              "minimum": 100,
              "maximum": 599
            },
            "outcome": {
              "enum": [
                "response_accepted",
                "body_completed",
                "body_failed",
                "retry_scheduled",
                "rejected",
                "transport_failed",
                "deadline_exceeded",
                "cancelled"
              ]
            },
            "terminal": { "type": "boolean" },
            "retry_delay_ms": { "type": ["integer", "null"], "minimum": 0 },
            "retry_after_used": { "type": "boolean" },
            "remaining_deadline_ms": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "assistant_delta": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        { "$ref": "#/$defs/turn_identity" },
        {
          "type": "object",
          "required": ["round", "text"],
          "properties": {
            "type": { "const": "assistant_delta" },
            "round": { "type": "integer", "minimum": 1 },
            "text": { "type": "string" }
          }
        }
      ]
    },
    "usage": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        { "$ref": "#/$defs/provider_operation_identity" },
        {
          "type": "object",
          "required": ["round", "purpose", "prompt_tokens", "completion_tokens", "total_tokens"],
          "properties": {
            "type": { "const": "usage" },
            "round": { "type": "integer", "minimum": 1 },
            "purpose": { "enum": ["inference", "compaction"] },
            "prompt_tokens": { "type": "integer", "minimum": 0 },
            "completion_tokens": { "type": "integer", "minimum": 0 },
            "total_tokens": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "tool_started": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        { "$ref": "#/$defs/turn_identity" },
        {
          "type": "object",
          "required": ["round", "call_id", "name", "args"],
          "properties": {
            "type": { "const": "tool_started" },
            "round": { "type": "integer", "minimum": 1 },
            "call_id": { "type": "string" },
            "name": { "type": "string" },
            "args": { "type": "string" },
            "command": { "$ref": "#/$defs/command_invocation" }
          }
        }
      ]
    },
    "tool_finished": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        { "$ref": "#/$defs/turn_identity" },
        {
          "type": "object",
          "required": ["round", "call_id", "name", "success", "cancelled", "output"],
          "properties": {
            "type": { "const": "tool_finished" },
            "round": { "type": "integer", "minimum": 1 },
            "call_id": { "type": "string" },
            "name": { "type": "string" },
            "success": { "type": "boolean" },
            "cancelled": { "type": "boolean" },
            "output": { "type": "string" },
            "output_bytes": { "type": "integer", "minimum": 0 },
            "output_retained_bytes": { "type": "integer", "minimum": 0 },
            "output_truncated": { "type": "boolean" },
            "artifact_status": {
              "enum": ["not_needed", "retained", "suppressed_by_policy", "unavailable", "failed"]
            },
            "command": { "$ref": "#/$defs/command_execution_result" }
          }
        }
      ]
    },
    "background_result": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": ["id", "task", "status", "result", "joined"],
          "properties": {
            "type": { "const": "background_result" },
            "id": { "type": "integer", "minimum": 1 },
            "task": { "type": "string" },
            "status": { "enum": ["done", "failed", "cancelled"] },
            "result": { "type": "string" },
            "joined": { "type": "boolean" }
          }
        }
      ]
    },
    "assistant": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        { "$ref": "#/$defs/turn_identity" },
        {
          "type": "object",
          "required": ["text"],
          "properties": {
            "type": { "const": "assistant" },
            "text": { "type": "string" }
          }
        }
      ]
    },
    "assistant_disposition": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        { "$ref": "#/$defs/turn_identity" },
        {
          "type": "object",
          "required": ["status"],
          "properties": {
            "type": { "const": "assistant_disposition" },
            "status": { "enum": ["committed", "committed_partial", "discarded"] },
            "reason": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "turn_finished": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        { "$ref": "#/$defs/turn_identity" },
        {
          "type": "object",
          "required": ["status"],
          "properties": {
            "type": { "const": "turn_finished" },
            "status": { "enum": ["ok", "partial", "error", "cancelled"] },
            "background_writes": { "type": "integer", "minimum": 0 },
            "tool_errors": { "type": "integer", "minimum": 0 },
            "policy_errors": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "output_schema": {
      "description": "Host-validated structured-output constraint active for this automation run. The schema body and source path are intentionally omitted.",
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": [
            "name",
            "bytes",
            "sha256",
            "strict",
            "provider_format",
            "schema_preflight_validated",
            "local_validation",
            "schema_content_included",
            "model_file_authority"
          ],
          "properties": {
            "type": { "const": "output_schema" },
            "name": { "const": "kitsu_output" },
            "bytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "strict": { "const": true },
            "provider_format": { "const": "json_schema" },
            "schema_preflight_validated": { "const": true },
            "local_validation": { "const": true },
            "schema_content_included": { "const": false },
            "model_file_authority": { "const": false }
          }
        }
      ]
    },
    "completion_postcondition": {
      "description": "Host-enforced automation completion contract requested by --require-write and/or --require-write-sha256. The armed receipt precedes the first turn; the evaluated receipt follows completed turns and precedes any output_last_message installation.",
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": [
            "phase",
            "condition",
            "status",
            "targets",
            "results",
            "verification",
            "model_disclosed",
            "write_authority_granted"
          ],
          "properties": {
            "type": { "const": "completion_postcondition" },
            "phase": { "enum": ["armed", "evaluated"] },
            "condition": { "const": "required_write" },
            "status": { "enum": ["pending", "satisfied", "failed"] },
            "targets": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "expectations": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["path", "sha256"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
                }
              }
            },
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "requested_path",
                  "satisfied",
                  "journal_recorded",
                  "journal_net_content_changed",
                  "current_matches_latest_write",
                  "final_state_changed",
                  "initial_bytes",
                  "initial_sha256",
                  "final_bytes",
                  "final_sha256",
                  "reason"
                ],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "requested_path": { "type": "string", "minLength": 1 },
                  "satisfied": { "type": "boolean" },
                  "journal_recorded": { "type": "boolean" },
                  "journal_net_content_changed": { "type": "boolean" },
                  "current_matches_latest_write": { "type": "boolean" },
                  "final_state_changed": { "type": "boolean" },
                  "initial_bytes": { "type": ["integer", "null"], "minimum": 0 },
                  "initial_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
                  "final_bytes": { "type": ["integer", "null"], "minimum": 0 },
                  "final_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
                  "expected_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
                  "expected_sha256_matches": { "type": ["boolean", "null"] },
                  "reason": { "type": ["string", "null"] }
                }
              }
            },
            "verification": { "const": "verified_model_fs_write_and_final_state_change" },
            "model_disclosed": { "const": true },
            "write_authority_granted": { "const": false }
          }
        }
      ]
    },
    "output_last_message": {
      "description": "Host-owned atomic installation of the last fully committed assistant message requested by --output-last-message. The message body is not duplicated in this receipt.",
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        { "$ref": "#/$defs/turn_identity" },
        {
          "type": "object",
          "required": [
            "destination",
            "bytes",
            "sha256",
            "atomic",
            "assistant_committed",
            "content_included",
            "model_write_authority"
          ],
          "properties": {
            "type": { "const": "output_last_message" },
            "destination": { "type": "string", "minLength": 1 },
            "bytes": { "type": "integer", "minimum": 0 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "atomic": { "const": true },
            "assistant_committed": { "const": true },
            "content_included": { "const": false },
            "model_write_authority": { "const": false }
          }
        }
      ]
    },
    "command_started": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": ["line", "command"],
          "properties": {
            "type": { "const": "command_started" },
            "line": { "type": "integer", "minimum": 1 },
            "command": { "type": "string" }
          }
        }
      ]
    },
    "command_finished": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": ["line", "command", "status"],
          "properties": {
            "type": { "const": "command_finished" },
            "line": { "type": "integer", "minimum": 1 },
            "command": { "type": "string" },
            "status": { "enum": ["ok", "error", "cancelled"] }
          }
        }
      ]
    },
    "command_result": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": ["line", "command", "result"],
          "properties": {
            "type": { "const": "command_result" },
            "line": { "type": "integer", "minimum": 1 },
            "command": { "type": "string" },
            "result": {
              "type": "object",
              "required": ["kind"]
            }
          }
        }
      ]
    },
    "error": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": ["kind", "message", "exit_code"],
          "properties": {
            "type": { "const": "error" },
            "turn_id": { "type": "string" },
            "line": { "type": "integer", "minimum": 1 },
            "command": { "type": "string" },
            "kind": { "type": "string" },
            "cause": {
              "enum": ["tool_call_during_tool_free_finalization"]
            },
            "message": { "type": "string" },
            "exit_code": { "type": "integer" },
            "tool_errors": { "type": "integer", "minimum": 0 },
            "policy_errors": { "type": "integer", "minimum": 0 },
            "schema_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "instance_path": { "type": "string", "pattern": "^\\$" },
            "validation_keyword": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "final_summary": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": [
            "status",
            "failures",
            "provider_failures",
            "tool_failures",
            "policy_failures",
            "user_failures",
            "cancelled_failures"
          ],
          "properties": {
            "type": { "const": "final_summary" },
            "status": { "enum": ["ok", "partial", "error", "cancelled"] },
            "failures": { "type": "integer", "minimum": 0 },
            "provider_failures": { "type": "integer", "minimum": 0 },
            "output_schema_failures": { "type": "integer", "minimum": 0 },
            "postcondition_failures": { "type": "integer", "minimum": 0 },
            "tool_failures": { "type": "integer", "minimum": 0 },
            "policy_failures": { "type": "integer", "minimum": 0 },
            "tool_errors": { "type": "integer", "minimum": 0 },
            "policy_errors": { "type": "integer", "minimum": 0 },
            "recovered_tool_errors": { "type": "integer", "minimum": 0 },
            "recovered_policy_errors": { "type": "integer", "minimum": 0 },
            "user_failures": { "type": "integer", "minimum": 0 },
            "cancelled_failures": { "type": "integer", "minimum": 0 },
            "duration_ms": { "type": "integer", "minimum": 0 },
            "session_id": { "type": ["string", "null"] },
            "session_snapshot_state": { "enum": ["disabled", "pending_until_first_success", "resumable"] }
          }
        }
      ]
    },
    "context_window_mismatch": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": [
            "reported_prompt_tokens",
            "estimated_sent_tokens",
            "resolved_window"
          ],
          "properties": {
            "type": { "const": "context_window_mismatch" },
            "turn_id": { "type": "string", "minLength": 1 },
            "reported_prompt_tokens": { "type": "integer", "minimum": 0 },
            "estimated_sent_tokens": { "type": "integer", "minimum": 0 },
            "resolved_window": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "review_disclosure": {
      "description": "One bounded disclosure of host-verified workspace evidence by the top-level kitsu review command. Emitted after run_started and before turn_started; it grants no model read root.",
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": [
            "source",
            "target",
            "truncated",
            "evidence_bytes",
            "model_disclosed",
            "model_read_root_granted"
          ],
          "properties": {
            "type": { "const": "review_disclosure" },
            "source": { "const": "top_level_review" },
            "target": { "type": "string", "minLength": 1 },
            "resolved_revision": { "type": ["string", "null"] },
            "merge_base": { "type": ["string", "null"] },
            "truncated": { "type": "boolean" },
            "evidence_bytes": { "type": "integer", "minimum": 0 },
            "model_disclosed": { "const": true },
            "model_read_root_granted": { "const": false }
          }
        }
      ]
    },
    "workspace_evidence_disclosure": {
      "description": "One bounded disclosure of host-verified workspace evidence to the provider through the model-callable workspace_diff tool — the review_disclosure field set generalized to the tool surface. Emitted between the tool's tool_started and tool_finished frames.",
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": [
            "source",
            "target",
            "truncated",
            "evidence_bytes",
            "model_disclosed",
            "model_read_root_granted"
          ],
          "properties": {
            "type": { "const": "workspace_evidence_disclosure" },
            "source": { "const": "workspace_diff" },
            "target": { "type": "string", "minLength": 1 },
            "resolved_revision": { "type": ["string", "null"] },
            "merge_base": { "type": ["string", "null"] },
            "truncated": { "type": "boolean" },
            "evidence_bytes": { "type": "integer", "minimum": 0 },
            "model_disclosed": { "const": true },
            "model_read_root_granted": { "const": false }
          }
        }
      ]
    },
    "rollback_retained_changes": {
      "description": "A failed/cancelled turn's conversation state was rolled back while completed file changes it made remain on disk. Emitted after that turn's turn_finished; a host-authored briefing message enumerating the retained paths was injected into the surviving conversation state (note_injected). Paths are bounded to a fixed cap; omitted_paths counts the rest. No diff bodies are included.",
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "required": ["checkpoints", "change_count", "paths", "note_injected"],
          "properties": {
            "type": { "const": "rollback_retained_changes" },
            "turn_id": { "type": "string", "minLength": 1 },
            "checkpoints": {
              "type": "array",
              "items": { "type": "integer", "minimum": 0 }
            },
            "change_count": { "type": "integer", "minimum": 1 },
            "paths": {
              "type": "array",
              "items": { "type": "string" }
            },
            "omitted_paths": { "type": "integer", "minimum": 0 },
            "note_injected": { "const": true }
          }
        }
      ]
    },
    "forward_compatible_event": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "properties": {
            "type": {
              "not": {
                "enum": [
                  "run_started",
                  "model_catalog",
                  "turn_started",
                  "provider_request",
                  "structured_finalization_deferred",
                  "provider_attempt",
                  "assistant_delta",
                  "usage",
                  "tool_started",
                  "tool_finished",
                  "background_result",
                  "assistant",
                  "assistant_disposition",
                  "turn_finished",
                  "output_schema",
                  "completion_postcondition",
                  "output_last_message",
                  "command_started",
                  "command_result",
                  "command_finished",
                  "context_window_mismatch",
                  "review_disclosure",
                  "workspace_evidence_disclosure",
                  "rollback_retained_changes",
                  "error",
                  "final_summary"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
